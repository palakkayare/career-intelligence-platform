SALARY_IP_PEPPER=

REDIS_CACHE_URL=redis://localhost:6379/3
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Test keys only. Leave blank to skip payments locally.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
